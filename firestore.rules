rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTH / ROLE HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdminDoc(docId) {
      return exists(/databases/$(database)/documents/students/$(docId)) &&
        get(/databases/$(database)/documents/students/$(docId)).data.role in [
          'admin', '4', 4
        ];
    }

    function isAdmin() {
      return signedIn() && (
        (('role' in request.auth.token) && request.auth.token.role == 'admin') ||
        isAdminDoc(request.auth.uid) ||
        (
          request.auth.token.email != null &&
          isAdminDoc(request.auth.token.email.split('@')[0])
        )
      );
    }

    function isStaffDoc(docId) {
      return exists(/databases/$(database)/documents/students/$(docId)) &&
        get(/databases/$(database)/documents/students/$(docId)).data.role in [
          'moderator', 'teacher', 'admin', '2', '3', '4', 2, 3, 4
        ];
    }

    function isStaff() {
      return signedIn() && (
        (('role' in request.auth.token) && request.auth.token.role in [
          'moderator',
          'teacher',
          'admin'
        ]) ||
        isStaffDoc(request.auth.uid) ||
        (
          request.auth.token.email != null && 
          isStaffDoc(request.auth.token.email.split('@')[0])
        )
      );
    }

    function isStudentOwner(studentId) {
      return signedIn() && (
        request.auth.uid == studentId ||
        (exists(/databases/$(database)/documents/students/$(studentId)) &&
          get(/databases/$(database)/documents/students/$(studentId)).data.get('userId', null) == request.auth.uid) ||
        (
          request.auth.token.email != null &&
          request.auth.token.email.split('@')[0] == studentId
        )
      );
    }

    function isContentOwner(data) {
      return signedIn() && (
        (('userId' in data) && data.userId == request.auth.uid) ||
        (('realUserId' in data) && data.realUserId == request.auth.uid)
      );
    }

    // Staff members may review other users' moderation state, but they must
    // never approve their own flagged content and must not rewrite the
    // author's text while reviewing it. Content changes belong to the author
    // and must re-enter the pending -> OpenModeration flow.
    function isStaffModerationReview(data) {
      return isStaff() &&
        request.resource.data.moderationStatus in ['approved', 'pending'] &&
        request.resource.data.moderationReviewedBy == request.auth.uid &&
        request.resource.data.moderationReviewedAt is timestamp &&
        !(
          isContentOwner(data) &&
          ('moderationStatus' in data) &&
          data.moderationStatus == 'pending' &&
          request.resource.data.moderationStatus == 'approved'
        ) &&
        request.resource.data.diff(data).affectedKeys().hasOnly([
          'moderationStatus',
          'moderationReviewedAt',
          'moderationReviewedBy'
        ]);
    }

    function validPostFlair(data) {
      return data.flair in [
        'discussion', 'question', 'academic', 'study', 'help',
        'event_moments', 'community', 'fun_humor', 'achievement',
        'lost_found', 'projects', 'sports', 'announcement'
      ] && (data.flair != 'announcement' || isStaff());
    }

    function hasStudentRole(userId) {
      return userId is string &&
        exists(/databases/$(database)/documents/students/$(userId)) &&
        get(/databases/$(database)/documents/students/$(userId)).data.role in [
          'student', '1', 1
        ];
    }

    function isStudentAuthoredContent(data) {
      return (
        (('role' in data) && data.role in ['student', '1', 1]) ||
        (('userRole' in data) && data.userRole in ['student', '1', 1]) ||
        (('realUserId' in data) && hasStudentRole(data.realUserId)) ||
        (
          ('userId' in data) &&
          data.userId != 'anonymous' &&
          hasStudentRole(data.userId)
        )
      );
    }

    function isAnonymousContent(data) {
      return (
        (('isAnonymous' in data) && data.isAnonymous == true) ||
        (('userId' in data) && data.userId == 'anonymous')
      );
    }

    function validAiReplyUpdate() {
      return (
        !('aiReply' in request.resource.data) &&
        ('aiReply' in resource.data) &&
        resource.data.aiReply is map &&
        resource.data.aiReply.status == 'processing'
      ) || (
        request.resource.data.aiReply is map &&
        request.resource.data.aiReply.model in [
          'bonded-nlp-naive-bayes-v1',
          'bonded-intent-tfidf-logreg-v2'
        ] &&
        request.resource.data.aiReply.status in ['processing', 'completed']
      );
    }
    // =========================================================
    // SAFE LIST TOGGLE / COUNTER HELPERS
    // =========================================================

    function validOwnListToggle(oldList, newList) {
      return signedIn() &&
        oldList is list &&
        newList is list &&
        (
          (
            !(request.auth.uid in oldList) &&
            request.auth.uid in newList &&
            newList.toSet().difference(oldList.toSet()).hasOnly([request.auth.uid]) &&
            oldList.toSet().difference(newList.toSet()).size() == 0
          ) ||
          (
            request.auth.uid in oldList &&
            !(request.auth.uid in newList) &&
            oldList.toSet().difference(newList.toSet()).hasOnly([request.auth.uid]) &&
            newList.toSet().difference(oldList.toSet()).size() == 0
          )
        );
    }

    function validOwnListToggleWithCount(oldList, newList, oldCount, newCount) {
      return validOwnListToggle(oldList, newList) &&
        oldCount is number &&
        newCount is number &&
        (
          (
            !(request.auth.uid in oldList) &&
            request.auth.uid in newList &&
            newCount == oldCount + 1
          ) ||
          (
            request.auth.uid in oldList &&
            !(request.auth.uid in newList) &&
            newCount == oldCount - 1 &&
            newCount >= 0
          )
        );
    }

    // Older posts may not have likedBy/bookmarkedBy because those arrays were
    // not initialized when the post was created. Allow the first authenticated
    // user to create the missing list only with their own UID.
    function validInitialOwnListAdd(newList) {
      return signedIn() &&
        newList is list &&
        newList.size() == 1 &&
        request.auth.uid in newList;
    }

    function validInitialOwnLikeAdd(newList, newCount, oldData) {
      return validInitialOwnListAdd(newList) &&
        newCount is number &&
        (
          (
            ('likeCount' in oldData) &&
            oldData.likeCount is number &&
            newCount == oldData.likeCount + 1
          ) ||
          (
            !('likeCount' in oldData) &&
            newCount == 1
          )
        );
    }

    
    function isAiMessageOwner(data) {
  return signedIn() &&
    data.aiAssistant == true &&
    data.aiSourceMessageId is string &&
    exists(
      /databases/$(database)/documents/communityThreadMessages/$(data.aiSourceMessageId)
    ) &&
    (
      get(
        /databases/$(database)/documents/communityThreadMessages/$(data.aiSourceMessageId)
      ).data.userId == request.auth.uid ||
      get(
        /databases/$(database)/documents/communityThreadMessages/$(data.aiSourceMessageId)
      ).data.realUserId == request.auth.uid
    ) &&
    get(
      /databases/$(database)/documents/communityThreadMessages/$(data.aiSourceMessageId)
    ).data.serverId == data.serverId &&
    get(
      /databases/$(database)/documents/communityThreadMessages/$(data.aiSourceMessageId)
    ).data.channelId == data.channelId;
}
    // =========================================================
    // COMMUNITY MEMBERSHIP
    // =========================================================

    function isServerMember(serverId) {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/communityServerMemberships/$(serverId + '_' + request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/communityServerMemberships/$(serverId + '_' + request.auth.uid)
        ).data.status == 'joined';
    }

    // A public server's channels are open to any signed-in user (Home lets
    // anyone open them). A private server's messages stay readable only by
    // its joined members and by staff.
    function isPublicServer(serverId) {
      return exists(
          /databases/$(database)/documents/communityServers/$(serverId)
        ) &&
        get(
          /databases/$(database)/documents/communityServers/$(serverId)
        ).data.get('isPublic', false) == true;
    }

    // Task 3: who may pin/unpin messages in a server's channels — the server's
    // creator/owner or any app-wide staff member. Same authority shape as the
    // communityServers update/delete rule; identical get()s in one evaluation
    // are cached, so this costs a single extra read.
    function canManageServerPins(serverId) {
      return signedIn() && (
        isStaff() ||
        get(
          /databases/$(database)/documents/communityServers/$(serverId)
        ).data.createdBy == request.auth.uid ||
        get(
          /databases/$(database)/documents/communityServers/$(serverId)
        ).data.ownerId == request.auth.uid
      );
    }

    // Rules & Announcements permissions:
    // Only staff (admin, moderator, teacher) or server owner can post messages
    // in rules and announcements channels. Students can only react and forward.
    function isStaffOnlyChannel(channelId) {
      return channelId.matches('.*(_rules|_announcement|_announcements).*');
    }

    function canPostInThreadChannel(serverId, channelId) {
      return !isStaffOnlyChannel(channelId) ||
        isStaff() ||
        (
          exists(/databases/$(database)/documents/communityServers/$(serverId)) &&
          (
            get(/databases/$(database)/documents/communityServers/$(serverId)).data.createdBy == request.auth.uid ||
            get(/databases/$(database)/documents/communityServers/$(serverId)).data.ownerId == request.auth.uid
          )
        );
    }

    // =========================================================
    // POST MODERATION
    // =========================================================

    function isApprovedPost(data) {
      return !('moderationStatus' in data) ||
        data.moderationStatus == 'approved';
    }


    // =========================================================
    // COMMUNITY SERVERS
    // =========================================================

    match /communityServers/{serverId} {

      allow read, list: if signedIn();

      allow create: if signedIn() && isStaff();

      allow update: if signedIn() && (
        isAdmin() ||
        (
          (
            isStaff() ||
            resource.data.createdBy == request.auth.uid ||
            resource.data.ownerId == request.auth.uid
          ) &&
          // Task 6: flipping a server into the deleted state is no longer a
          // unilateral teacher action. Only an admin may set isDeleted — either
          // directly, or by approving a communityServerDeletionRequests entry.
          // Every other server edit (name, accent, sections, memberCount, …)
          // is unchanged for owners/staff.
          request.resource.data.get('isDeleted', false) != true
        )
      );

      allow delete: if signedIn() && (
        isStaff() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
    }


    // =========================================================
    // SERVER DELETION REQUESTS
    // =========================================================
    // Task 6: a teacher (server owner/creator or staff) asks for a server to
    // be deleted; an admin approves or rejects. Mirrors the join-request shape
    // — signed-in read, id-bound self create, requester can delete/cancel —
    // but the review (status -> approved/rejected) is admin-only, since a
    // teacher is also "staff" and must not resolve a deletion request.

    match /communityServerDeletionRequests/{requestId} {

      allow read, list: if signedIn();

      allow create: if signedIn() &&
        isStaff() &&
        request.resource.data.requestedBy == request.auth.uid &&
        requestId == request.resource.data.serverId + '_' + request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.serverId is string &&
        request.resource.data.serverName is string &&
        request.resource.data.createdAt is timestamp;

      // Admin review only — the sole path that sets an approved/rejected status
      // and the reviewer fields. A teacher is also "staff" but must NOT resolve
      // a deletion request (their own or a peer's), so this is isAdmin(), not
      // isStaff(). The client pairs 'approved' with the actual server
      // soft-delete. The requester doesn't update — they cancel or re-submit
      // by deleting (below) and creating a fresh request, mirroring how join
      // requests are torn down.
      allow update: if signedIn() &&
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedAt', 'updatedAt'
        ]) &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt is timestamp;

      // Mirrors the join-request delete clause: staff cleanup, or the
      // requester cancelling / clearing their own request.
      allow delete: if signedIn() && (
        isStaff() ||
        resource.data.requestedBy == request.auth.uid
      );
    }


    // =========================================================
    // SERVER MEMBERSHIPS
    // =========================================================

    match /communityServerMemberships/{membershipId} {

      allow read, list: if signedIn();

      allow create: if signedIn() && (
        isStaff() ||
        request.resource.data.userId == request.auth.uid
      );

      allow update, delete: if signedIn() && (
        isStaff() ||
        resource.data.userId == request.auth.uid
      );
    }


    // =========================================================
    // SERVER JOIN REQUESTS
    // =========================================================

    match /communityServerJoinRequests/{requestId} {

      allow read, list: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if signedIn() && (
        isStaff() ||
        resource.data.userId == request.auth.uid
      );
    }


    // =========================================================
    // COMMUNITY THREAD MESSAGES
    // =========================================================

   match /communityThreadMessages/{messageId} {

  // Reading a channel's messages requires actually having access to that
  // server: a joined member, a public server, or staff. Before this, any
  // signed-in user could read every message in every private server.
  allow read, list: if signedIn() && (
    isServerMember(resource.data.serverId) ||
    isPublicServer(resource.data.serverId) ||
    isStaff()
  );

  allow create: if signedIn() &&
    request.resource.data.createdAt is timestamp &&
    request.resource.data.serverId is string &&
    request.resource.data.channelId is string &&
    (
      (
        (
          request.resource.data.userId == request.auth.uid ||
          (request.resource.data.userId == 'anonymous' && request.resource.data.realUserId == request.auth.uid)
        ) &&
        request.resource.data.moderationStatus == 'pending'
      ) ||
      (
        isAiMessageOwner(request.resource.data) &&
        request.resource.data.moderationStatus == 'approved'
      )
    ) &&
    (
      isServerMember(request.resource.data.serverId) ||
      isStaff()
    ) &&
    canPostInThreadChannel(request.resource.data.serverId, request.resource.data.channelId);

  allow update: if signedIn() && (
    (
      isContentOwner(resource.data) &&
      request.resource.data.userId == resource.data.userId &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'text', 'files', 'taggedUsers', 'link', 'updatedAt',
        'moderationStatus', 'moderationReasons', 'moderatedAtMs',
        'moderationModel', 'moderationRuleSource', 'aiReply'
      ]) &&
      request.resource.data.moderationStatus == 'pending'
    ) ||
    (
      isAiMessageOwner(resource.data) &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'text', 'aiStatus'
      ])
    ) ||
    (
      // Reactions: any joined member of the server can toggle their own
      // reaction on ANY message in it, not just their own. Deliberately
      // narrow — this branch can only ever write the `reactions` field, so
      // it does not loosen the author-only text/attachment edit branch above.
      isServerMember(resource.data.serverId) &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'reactions'
      ])
    ) ||
    (
      // Pins (Task 3): a server owner/creator or app-wide staff can pin or
      // unpin any message in that server's channels. Same narrow principle as
      // the reactions branch — this branch can ONLY write the pin fields, so
      // it never loosens the author-only edit branch above.
      canManageServerPins(resource.data.serverId) &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'pinned', 'pinnedAt', 'pinnedBy', 'pinnedByName'
      ])
    ) ||
    (
      // Self-edit (Task 4A): the message's own author fixing a typo in text
      // they already sent. This is routine chat hygiene, NOT a moderation
      // event, so it deliberately does not re-enter the pending flow the
      // author branch above requires. Strictly author-only (isContentOwner,
      // never the "any member" reactions permission), scoped to exactly
      // text + editedAt, and only within 15 minutes of sending so an old
      // message others have already seen can't be rewritten.
      isContentOwner(resource.data) &&
      request.resource.data.userId == resource.data.userId &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'text', 'editedAt'
      ]) &&
      request.resource.data.text is string &&
      request.resource.data.text.size() > 0 &&
      request.resource.data.editedAt is timestamp &&
      request.time < resource.data.createdAt + duration.value(15, 'm')
    ) ||
    isStaffModerationReview(resource.data)
  );

  allow delete: if signedIn() && (
    isContentOwner(resource.data) ||
    isStaff()
  );
}


    // =========================================================
    // CHANNEL READ RECEIPTS
    // =========================================================
    // One doc per member per channel (id = "<channelId>_<uid>") recording how
    // far they've read, with name/avatar denormalised for the read strip. A
    // member can only ever write their own doc.

    match /channelReads/{readId} {

      allow read, list: if signedIn();

      allow create, update: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        readId == request.resource.data.channelId + '_' + request.auth.uid &&
        request.resource.data.serverId is string &&
        request.resource.data.channelId is string &&
        request.resource.data.lastReadAtMs is number &&
        request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // Feature 6: transient "user X is typing in channel Y" presence. One doc per
    // user per channel, id-bound to the writer, and only ever carrying the
    // typing fields. A user may clear their own doc; nobody else's.
    match /typingIndicators/{typingId} {

      allow read, list: if signedIn();

      allow create, update: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        typingId == request.resource.data.channelId + '_' + request.auth.uid &&
        request.resource.data.serverId is string &&
        request.resource.data.channelId is string &&
        request.resource.data.updatedAt is timestamp;

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Task 4B: per-user, per-channel notification mute. One doc per user per
    // channel (id = "<channelId>_<uid>"); presence == muted. Publicly readable
    // like channelReads so a sender can skip muted recipients at mention
    // fan-out. A user may only create/clear their own doc — muting for
    // yourself never affects anyone else.
    match /channelMutes/{muteId} {

      allow read, list: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        muteId == request.resource.data.channelId + '_' + request.auth.uid &&
        request.resource.data.serverId is string &&
        request.resource.data.channelId is string &&
        request.resource.data.updatedAt is timestamp;

      allow update: if false;

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }


    // =========================================================
    // DIRECT CONVERSATIONS & MESSAGES (MESSENGER)
    // =========================================================

    // Private, expiring UI status; deliberately independent of inbox membership.
    match /directTyping/{conversationId}/users/{userId} {
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create, update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['userId', 'participants', 'active', 'updatedAt']) &&
        request.resource.data.userId == userId && request.resource.data.active is bool &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.participants is list && request.resource.data.participants.size() == 2 &&
        request.resource.data.participants[0] is string && request.resource.data.participants[1] is string &&
        request.resource.data.participants[0] != request.resource.data.participants[1] &&
        userId in request.resource.data.participants &&
        conversationId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1] &&
        (resource == null || request.resource.data.participants == resource.data.participants);
    }

    match /directConversations/{conversationId} {
      function ownMapChange(field) {
        return request.resource.data.get(field, {}).diff(resource.data.get(field, {}))
          .affectedKeys().hasOnly([request.auth.uid]);
      }

      function validReceipt(field) {
        let before = resource.data.get(field, {});
        let after = request.resource.data.get(field, {});
        return ownMapChange(field) && (
          before == after || (
            after.get(request.auth.uid, null) is timestamp &&
            after[request.auth.uid] <= request.time &&
            (!(request.auth.uid in before) || after[request.auth.uid] >= before[request.auth.uid])
          )
        );
      }

      function validMetadataUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let oldMute = resource.data.get('mutedBy', []);
        let newMute = request.resource.data.get('mutedBy', []);
        return changed.hasOnly(['participantDetails', 'nicknames', 'themeColor', 'quickEmoji',
            'mutedBy', 'pinnedMessageIds', 'lastReadAt', 'lastDeliveredAt', 'unreadCounts']) &&
          ownMapChange('participantDetails') && validReceipt('lastReadAt') && validReceipt('lastDeliveredAt') &&
          (oldMute == newMute || validOwnListToggle(oldMute, newMute)) &&
          ownMapChange('unreadCounts') &&
          (!changed.hasAny(['unreadCounts']) || request.resource.data.unreadCounts[request.auth.uid] == 0);
      }

      function validNewMessage() {
        let after = request.resource.data;
        let latest = after.lastMessage;
        let messagePath = /databases/$(database)/documents/directConversations/$(conversationId)/messages/$(latest.id);
        let message = getAfter(messagePath).data;
        return !exists(messagePath) && latest.senderId == request.auth.uid &&
          latest.createdAt == request.time && after.updatedAt == request.time &&
          message.senderId == request.auth.uid && message.createdAt == request.time &&
          (latest.text == message.text || (message.text == '' && latest.text in ['Sent an image', 'Sent a file']));
      }

      function validSendUpdate() {
        let after = request.resource.data;
        let recipient = resource.data.participants[0] == request.auth.uid
          ? resource.data.participants[1] : resource.data.participants[0];
        let oldCounts = resource.data.get('unreadCounts', {});
        return after.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'unreadCounts', 'participantDetails']) &&
          validNewMessage() && ownMapChange('participantDetails') &&
          after.unreadCounts.diff(oldCounts).affectedKeys().hasOnly([recipient]) &&
          after.unreadCounts[recipient] == oldCounts.get(recipient, 0) + 1;
      }

      function validDeleteForMe() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedThrough', 'unreadCounts']) &&
          validReceipt('deletedThrough') && ownMapChange('unreadCounts') &&
          request.resource.data.deletedThrough[request.auth.uid] == resource.data.lastMessage.createdAt &&
          request.resource.data.unreadCounts[request.auth.uid] == 0;
      }

      function validArchiveForMe() {
        let archived = request.resource.data.get('archivedThrough', {}).get(request.auth.uid, null);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archivedThrough']) &&
          ownMapChange('archivedThrough') &&
          resource.data.lastMessage.createdAt > resource.data.get('deletedThrough', {}).get(request.auth.uid, timestamp.value(0)) &&
          (archived == null || archived == resource.data.lastMessage.createdAt);
      }

      function validDeletedPreview() {
        let before = resource.data.lastMessage;
        let after = request.resource.data.lastMessage;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'pinnedMessageIds']) &&
          before.senderId == request.auth.uid &&
          after.diff(before).affectedKeys().hasOnly(['text', 'isImage', 'isFile']) &&
          after.text == 'Message deleted' && after.isImage == false && after.isFile == false;
      }

      function validEditUpdate() {
        let after = request.resource.data;
        let message = getAfter(/databases/$(database)/documents/directConversations/$(conversationId)/messages/$(after.lastEditedMessageId)).data;
        return after.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastEditedMessageId', 'contentUpdatedAt']) &&
          after.contentUpdatedAt == request.time && message.editedAt == request.time &&
          message.senderId == request.auth.uid && message.get('deleted', false) == false &&
          (resource.data.lastMessage.id == after.lastEditedMessageId
            ? (after.lastMessage.diff(resource.data.lastMessage).affectedKeys().hasOnly(['text']) && after.lastMessage.text == message.text)
            : after.lastMessage == resource.data.lastMessage);
      }

      // Participant can read the conversation; allow get when doc does not exist yet
      allow get: if signedIn() && (
        resource == null ||
        request.auth.uid in resource.data.participants
      );
      allow list: if signedIn() && request.auth.uid in resource.data.participants;

      // A new conversation must be created atomically with its first message.
      allow create: if signedIn() &&
        request.resource.data.type == 'direct' &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.participants.toSet().size() == 2 &&
        request.resource.data.participants[0] is string &&
        request.resource.data.participants[1] is string &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.get('lastReadAt', {}) == {} &&
        request.resource.data.get('lastDeliveredAt', {}) == {} &&
        request.resource.data.get('deletedThrough', {}) == {} &&
        request.resource.data.get('archivedThrough', {}) == {} &&
        request.resource.data.unreadCounts.keys().hasOnly(request.resource.data.participants) &&
        request.resource.data.unreadCounts[request.auth.uid] == 0 &&
        request.resource.data.unreadCounts[
          request.resource.data.participants[0] == request.auth.uid
            ? request.resource.data.participants[1] : request.resource.data.participants[0]
        ] == 1 && validNewMessage();

      // Participants can update conversation metadata (lastMessage, unreadCounts, nicknames, themes, pins, mutes)
      allow update: if signedIn() && request.auth.uid in resource.data.participants &&
        (validMetadataUpdate() || validSendUpdate() || validDeletedPreview() || validDeleteForMe() || validEditUpdate() || validArchiveForMe());

      // Normal users delete their own view through deletedThrough, never the shared thread.
      allow delete: if signedIn() && isStaff();

      match /messages/{messageId} {
        function validReaction(emoji) {
          let before = resource.data.get('reactions', {}).get(emoji, []);
          let after = request.resource.data.get('reactions', {}).get(emoji, []);
          return before == after || validOwnListToggle(before, after);
        }

        // MUST match EMOJI_REACTIONS in DirectChatScreen exactly. When these
        // drifted apart, the two reactions the picker offered but the rules
        // did not know about were refused outright — the write is
        // fire-and-forget, so it surfaced only as an unhandled
        // "Missing or insufficient permissions" in the console.
        function validReactions() {
          return request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {}))
              .affectedKeys().hasOnly(['❤️', '😆', '😮', '😢', '😡', '👍']) &&
            validReaction('❤️') && validReaction('😆') && validReaction('😮') &&
            validReaction('😢') && validReaction('😡') && validReaction('👍');
        }

        function validTextEdit() {
          let parent = getAfter(/databases/$(database)/documents/directConversations/$(conversationId)).data;
          return resource.data.senderId == request.auth.uid && resource.data.get('deleted', false) == false &&
            resource.data.text.size() > 0 &&
            resource.data.createdAt > parent.get('deletedThrough', {}).get(request.auth.uid, timestamp.value(0)) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt']) &&
            request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 &&
            request.resource.data.edited == true && request.resource.data.editedAt == request.time &&
            parent.lastEditedMessageId == messageId && parent.contentUpdatedAt == request.time;
        }

        // Participants of the parent conversation can read/list messages
        allow read, list: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/directConversations/$(conversationId)).data.participants;

        // Participants can send messages (senderId must match auth.uid)
        allow create: if signedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.conversationId == conversationId &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.text is string && request.resource.data.text.size() <= 2000 &&
          request.resource.data.files is list && request.resource.data.files.size() <= 10 &&
          (request.resource.data.text.size() > 0 || request.resource.data.files.size() > 0) &&
          request.resource.data.status == 'sent' &&
          request.resource.data.seenBy.keys().hasOnly([request.auth.uid]) &&
          request.resource.data.seenBy[request.auth.uid] == request.time &&
          request.resource.data.reactions == {} && request.resource.data.pinned == false &&
          request.resource.data.get('deleted', false) == false &&
          getAfter(/databases/$(database)/documents/directConversations/$(conversationId)).data.lastMessage.id == messageId &&
          request.auth.uid in getAfter(/databases/$(database)/documents/directConversations/$(conversationId)).data.participants;

        // Participants can update reactions, seenBy/status, pins, or edit their own message
      allow update: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/directConversations/$(conversationId)).data.participants &&
          (
            validTextEdit() ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) && validReactions()) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'pinnedAt', 'pinnedBy']) &&
              request.resource.data.pinned is bool &&
              (request.resource.data.pinned == false ||
                (request.resource.data.pinnedBy == request.auth.uid && request.resource.data.pinnedAt == request.time))) ||
            (resource.data.senderId == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'files', 'deleted', 'pinned', 'editedAt']) &&
              request.resource.data.deleted == true && request.resource.data.text == 'Message deleted' &&
              request.resource.data.files == [] && request.resource.data.pinned == false &&
              request.resource.data.editedAt == request.time)
          );

        // Author or staff can delete
        allow delete: if signedIn() && (
          resource.data.senderId == request.auth.uid ||
          isStaff()
        );
      }
    }


    // =========================================================
    // STUDENTS / USERS
    // =========================================================

    match /students/{studentId} {

  // Authenticated users can read student profiles.
  allow read, list: if signedIn();

  // Only administrators can create student profiles.
  allow create: if isAdmin();

  function validSetupChanges() {
    let changed = request.resource.data.diff(resource.data).affectedKeys();
    return (!changed.hasAny(['communityRulesVersion', 'communityRulesAcceptedAt']) || (
      request.resource.data.communityRulesVersion == '2026-09-12' &&
      request.resource.data.communityRulesAcceptedAt == request.time
    ));
  }

  // Identity, permissions, verified recovery data, and password state are
  // controlled by administrators/the trusted backend, never self-service edits.
  // Academic standing is set by administrators and by the scheduled year
  // level promotion, never by the student. Without yearlvl on this list a
  // student could simply write their own promotion back the way it was.
  allow update: if signedIn() && (
    (isStudentOwner(studentId) &&
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'permissions', 'userId', 'uid', 'studentID', 'firstname', 'lastname',
        'mustChangePassword', 'passwordCheckedAt', 'recoveryEmail',
        'recoveryEmailVerified', 'recoveryEmailVerifiedAt',
        'yearlvl', 'promotionHold', 'previousYearlvl', 'promotedAt',
        'lastPromotionRunId'
      ]) && validSetupChanges()) ||
    isAdmin()
  );

  // Student can delete their own profile.
  // Admin can delete any student.
  allow delete: if signedIn() && (
    isStudentOwner(studentId) ||
    isAdmin()
  );
}



    // =========================================================
    // USER PUSH TOKENS
    // =========================================================

    match /userPushTokens/{userId} {

      allow read: if signedIn() &&
        request.auth.uid == userId;

      allow list: if signedIn() && isStaff();

      allow create, update, delete: if signedIn() &&
        request.auth.uid == userId;
    }
// =========================================================
// USER NOTIFICATION SETTINGS
// =========================================================

match /userNotificationSettings/{userId} {

  // User can read their own notification settings.
  allow read: if signedIn() &&
    request.auth.uid == userId;

  // User can create/update their own notification settings.
  allow create, update: if signedIn() &&
    request.auth.uid == userId &&
    request.resource.data.userId == request.auth.uid &&
    request.resource.data.soundId is string;

  // User can delete their own notification settings.
  allow delete: if signedIn() &&
    request.auth.uid == userId;
}

    // =========================================================
    // POSTS
    // =========================================================

    match /posts/{postId} {

      allow read: if signedIn() && (
        isApprovedPost(resource.data) ||
        isContentOwner(resource.data) ||
        isStaff()
      );

      // Spark-compatible architecture: clients may create/edit only PENDING
      // posts. The Cloudflare Worker uses a server credential to approve them or leave them pending for human review. A modified client cannot self-approve a post.
      allow create: if signedIn() &&
        request.resource.data.realUserId == request.auth.uid &&
        (
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.userId == 'anonymous'
        ) &&
        request.resource.data.username is string &&
        request.resource.data.content is string &&
        request.resource.data.createdAt is timestamp &&
        validPostFlair(request.resource.data) &&
        request.resource.data.moderationStatus == 'pending';

      allow update: if signedIn() && (
        isStaffModerationReview(resource.data) ||
        (
          isStaff() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pinnedAt',
            'pinnedBy',
            'pinExpiresAt',
            'targetDate',
            'targetDateLabel'
          ]) &&
          (
            (
              request.resource.data.pinnedAt is timestamp &&
              request.resource.data.pinnedBy == request.auth.uid
            ) ||
            (
              request.resource.data.pinnedAt == null &&
              request.resource.data.pinnedBy == null
            )
          )
        ) ||
        (
          isContentOwner(resource.data) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.realUserId == resource.data.realUserId &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'content',
              'searchTerms',
              'files',
              'taggedUsers',
              'isAnonymous',
              'link',
              'updatedAt',
              'moderationStatus',
              'moderationReasons',
              'moderatedAtMs',
              'aiPrompt',
              'flair',
              'pinnedAt',
              'pinnedBy',
              'pinExpiresAt',
              'targetDate',
              'targetDateLabel'
            ]) &&
          validPostFlair(request.resource.data) &&
          request.resource.data.moderationStatus == 'pending'
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likedBy', 'likeCount'
          ]) &&
          (
            (
              ('likedBy' in resource.data) &&
              ('likeCount' in resource.data) &&
              validOwnListToggleWithCount(
                resource.data.likedBy,
                request.resource.data.likedBy,
                resource.data.likeCount,
                request.resource.data.likeCount
              )
            ) ||
            (
              !('likedBy' in resource.data) &&
              validInitialOwnLikeAdd(
                request.resource.data.likedBy,
                request.resource.data.likeCount,
                resource.data
              )
            )
          )
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'bookmarkedBy'
          ]) &&
          (
            (
              ('bookmarkedBy' in resource.data) &&
              validOwnListToggle(
                resource.data.bookmarkedBy,
                request.resource.data.bookmarkedBy
              )
            ) ||
            (
              !('bookmarkedBy' in resource.data) &&
              validInitialOwnListAdd(request.resource.data.bookmarkedBy)
            )
          )
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'commentCount'
          ]) &&
          resource.data.commentCount is number &&
          request.resource.data.commentCount is number &&
          request.resource.data.commentCount >= 0 &&
          (
            request.resource.data.commentCount == resource.data.commentCount + 1 ||
            request.resource.data.commentCount == resource.data.commentCount - 1
          )
        ) ||
        (
          isContentOwner(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiReply']) &&
          validAiReplyUpdate()
        ) ||
        (
          // Part 4 (Lost & Found resolution detector): ANY signed-in user
          // (the commenter, not just the post owner) can flag a potential
          // resolution — this only ever sets a dismissible prompt, never
          // resolvedAt itself, and only on lost_found posts.
          resource.data.flair == 'lost_found' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolutionPrompt']) &&
          request.resource.data.resolutionPrompt is map
        ) ||
        (
          // Only the post owner can dismiss the prompt or confirm
          // resolution (the only path that ever sets resolvedAt).
          isContentOwner(resource.data) &&
          resource.data.flair == 'lost_found' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolvedAt', 'resolutionPrompt'])
        )
      );

      allow delete: if signedIn() && (
        isContentOwner(resource.data) ||
        isStaff()
      );
    }

    // =========================================================
    // COMMENTS
    // =========================================================

    match /comments/{commentId} {

      allow read: if signedIn();

      // Comments enter the database only as pending. The Cloudflare Worker
      // re-reads and moderates them before changing the moderation status.
      allow create: if signedIn() &&
        request.resource.data.postId is string &&
        request.resource.data.userId is string &&
        (request.resource.data.userId == request.auth.uid || request.resource.data.userId == 'anonymous') &&
        request.resource.data.realUserId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.likes is list &&
        request.resource.data.moderationStatus == 'pending';

      allow update: if signedIn() && (
        isStaffModerationReview(resource.data) ||
        (
          isContentOwner(resource.data) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.realUserId == resource.data.realUserId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text', 'files', 'taggedUsers', 'isAnonymous', 'link',
            'updatedAt', 'moderationStatus', 'moderationReasons',
            'moderatedAtMs', 'moderationModel', 'moderationRuleSource', 'aiReply'
          ]) &&
          request.resource.data.moderationStatus == 'pending'
        ) ||
        (
          isContentOwner(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiReply']) &&
          validAiReplyUpdate()
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          validOwnListToggle(resource.data.likes, request.resource.data.likes)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount']) &&
          resource.data.replyCount is number &&
          request.resource.data.replyCount is number &&
          request.resource.data.replyCount >= 0 &&
          (
            request.resource.data.replyCount == resource.data.replyCount + 1 ||
            request.resource.data.replyCount == resource.data.replyCount - 1
          )
        )
      );

      allow delete: if signedIn() && (
        isContentOwner(resource.data) ||
        isStaff()
      );
    }


    // =========================================================
    // REPLIES
    // =========================================================

    match /replies/{replyId} {

      allow read: if signedIn();

      // Replies follow the same server-authoritative moderation flow.
      allow create: if signedIn() &&
        request.resource.data.commentId is string &&
        request.resource.data.userId is string &&
        (request.resource.data.userId == request.auth.uid || request.resource.data.userId == 'anonymous') &&
        request.resource.data.realUserId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.moderationStatus == 'pending';

      allow update: if signedIn() && (
        isStaffModerationReview(resource.data) ||
        (
          isContentOwner(resource.data) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.realUserId == resource.data.realUserId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text', 'files', 'taggedUsers', 'isAnonymous', 'link',
            'updatedAt', 'moderationStatus', 'moderationReasons',
            'moderatedAtMs', 'moderationModel', 'moderationRuleSource', 'aiReply'
          ]) &&
          request.resource.data.moderationStatus == 'pending'
        ) ||
        (
          isContentOwner(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiReply']) &&
          validAiReplyUpdate()
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likedBy', 'likeCount'
          ]) &&
          validOwnListToggleWithCount(
            resource.data.likedBy,
            request.resource.data.likedBy,
            resource.data.likeCount,
            request.resource.data.likeCount
          )
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'seenBy'
          ]) &&
          validOwnListToggle(
            resource.data.seenBy,
            request.resource.data.seenBy
          )
        )
      );

      allow delete: if signedIn() && (
        isContentOwner(resource.data) ||
        isStaff()
      );
    }


    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{notificationId} {

      allow read: if signedIn() &&
        resource.data.recipientId == request.auth.uid;

      allow create: if signedIn() &&
        request.resource.data.recipientId is string &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.type is string &&
        request.resource.data.entityType is string &&
        request.resource.data.entityId is string &&
        request.resource.data.message is string &&
        request.resource.data.read is bool &&
        request.resource.data.createdAt is timestamp;

      allow update: if signedIn() && (
        (
          resource.data.recipientId == request.auth.uid &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'read'
            ])
        ) ||
        resource.data.actorId == request.auth.uid
      );

      allow delete: if signedIn() &&
        resource.data.actorId == request.auth.uid;
    }


    // =========================================================
    // POLLS
    // =========================================================

    match /polls/{pollId} {

      allow read: if signedIn();

      // Polls are created as pending. The Cloudflare Worker re-reads the
      // poll and uses OpenModeration before changing moderationStatus.
      allow create: if signedIn() &&
        request.resource.data.userId is string &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.question is string &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.moderationStatus == 'pending' &&
        validPostFlair(request.resource.data);

      allow update: if signedIn() && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'question',
            'imageUrl',
            'allowUsersToAddOption',
            'allowMultiple',
            'maxSelections',
            'durationMs',
            'expiresAt',
            'username',
            'isAnonymous',
            'flair',
            'updatedAt',
            'moderationStatus',
            'moderationReasons',
            'moderatedAtMs',
            'options',
            'totalVotes'
          ]) &&
          request.resource.data.moderationStatus == 'pending' &&
          validPostFlair(request.resource.data) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'options',
              'totalVotes'
            ]) ||
            (
              resource.data.totalVotes == 0 &&
              request.resource.data.totalVotes == 0 &&
              request.resource.data.options is list
            )
          )
        ) ||
        (
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'options',
            'totalVotes',
            'userVotes'
          ]) &&
          request.resource.data.options is list &&
          request.resource.data.totalVotes is number &&
          request.resource.data.totalVotes >= 0
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'commentCount'
          ]) &&
          resource.data.commentCount is number &&
          request.resource.data.commentCount is number &&
          request.resource.data.commentCount >= 0 &&
          (
            request.resource.data.commentCount == resource.data.commentCount + 1 ||
            request.resource.data.commentCount == resource.data.commentCount - 1
          )
        ) ||
        isStaffModerationReview(resource.data)
      );

      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isStaff()
      );
    }


    // =========================================================
    // EVENTS
    // =========================================================

    match /events/{eventId} {

      allow read, list: if signedIn();

      // isStaff() accepts either the custom auth claim OR the student
      // document. This rule used to trust the claim alone, and that claim is
      // only ever written once, when the account is registered — so promoting
      // someone to teacher in Manage Users gave them every other staff power
      // while Firestore still refused their events. Update and delete below
      // already used isStaff(); create was the odd one out.
      allow create: if signedIn() &&
        isStaff() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.date is string &&
        request.resource.data.category in [
          'morning',
          'afternoon',
          'evening',
          'all-day'
        ];

      allow update: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isStaff()
      );

      allow delete: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isStaff()
      );
    }


    // =========================================================
    // PROGRAMS / COURSES
    // =========================================================

    match /programs/{programId} {

      // Students, teachers, moderators and admins
      // can load programs for dropdowns.
      allow read, list: if signedIn();

      // Only admins can create programs.
      allow create: if isAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.code is string;

      // Only admins can edit programs.
      allow update: if isAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.code is string;

      // Only admins can delete programs.
      allow delete: if isAdmin();
    }


    // =========================================================
    // REPORTS
    // =========================================================

    match /reports/{reportId} {

      allow create: if signedIn() &&
        !isStaff() &&
        request.resource.data.reportedBy == request.auth.uid &&
        request.resource.data.contentType in ['post', 'poll', 'comment', 'reply', 'message'] &&
        request.resource.data.contentId is string &&
        request.resource.data.reason is string &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt is timestamp &&
        (
          (request.resource.data.contentType == 'post' &&
            exists(/databases/$(database)/documents/posts/$(request.resource.data.contentId)) &&
            !isContentOwner(get(/databases/$(database)/documents/posts/$(request.resource.data.contentId)).data) &&
            (
              isAnonymousContent(get(/databases/$(database)/documents/posts/$(request.resource.data.contentId)).data) ||
              isStudentAuthoredContent(get(/databases/$(database)/documents/posts/$(request.resource.data.contentId)).data)
            )) ||
          (request.resource.data.contentType == 'poll' &&
            exists(/databases/$(database)/documents/polls/$(request.resource.data.contentId)) &&
            !isContentOwner(get(/databases/$(database)/documents/polls/$(request.resource.data.contentId)).data) &&
            (
              isAnonymousContent(get(/databases/$(database)/documents/polls/$(request.resource.data.contentId)).data) ||
              isStudentAuthoredContent(get(/databases/$(database)/documents/polls/$(request.resource.data.contentId)).data)
            )) ||
          (request.resource.data.contentType == 'comment' &&
            exists(/databases/$(database)/documents/comments/$(request.resource.data.contentId)) &&
            !isContentOwner(get(/databases/$(database)/documents/comments/$(request.resource.data.contentId)).data) &&
            (
              isAnonymousContent(get(/databases/$(database)/documents/comments/$(request.resource.data.contentId)).data) ||
              isStudentAuthoredContent(get(/databases/$(database)/documents/comments/$(request.resource.data.contentId)).data)
            )) ||
          (request.resource.data.contentType == 'reply' &&
            exists(/databases/$(database)/documents/replies/$(request.resource.data.contentId)) &&
            !isContentOwner(get(/databases/$(database)/documents/replies/$(request.resource.data.contentId)).data) &&
            (
              isAnonymousContent(get(/databases/$(database)/documents/replies/$(request.resource.data.contentId)).data) ||
              isStudentAuthoredContent(get(/databases/$(database)/documents/replies/$(request.resource.data.contentId)).data)
            )) ||
          (request.resource.data.contentType == 'message' &&
            exists(/databases/$(database)/documents/communityThreadMessages/$(request.resource.data.contentId)) &&
            !isContentOwner(get(/databases/$(database)/documents/communityThreadMessages/$(request.resource.data.contentId)).data) &&
            (
              isAnonymousContent(get(/databases/$(database)/documents/communityThreadMessages/$(request.resource.data.contentId)).data) ||
              isStudentAuthoredContent(get(/databases/$(database)/documents/communityThreadMessages/$(request.resource.data.contentId)).data)
            ))
        );

      allow read, list: if isStaff();

      allow update, delete: if isStaff();
    }


    // =========================================================
    // AI DIRECT MESSAGES (private 1:1 chat with Bonded AI)
    // =========================================================

    match /aiDirectMessages/{userId}/messages/{messageId} {

      allow read, list: if signedIn() && request.auth.uid == userId;

      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.text is string &&
        request.resource.data.role in ['user', 'assistant'] &&
        request.resource.data.createdAt is timestamp;

      allow update, delete: if signedIn() && request.auth.uid == userId;
    }


    // =========================================================
    // AI CONVERSATIONS (multiple named chats per user; supersedes the
    // single aiDirectMessages thread above)
    // =========================================================

    // Per-user parent doc; only holds the one-time legacy-migration marker.
    match /aiConversations/{userId} {

      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /aiConversations/{userId}/conversations/{conversationId} {

      allow read, list: if signedIn() && request.auth.uid == userId;

      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /aiConversations/{userId}/conversations/{conversationId}/messages/{messageId} {

      allow read, list: if signedIn() && request.auth.uid == userId;

      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.text is string &&
        request.resource.data.role in ['user', 'assistant'] &&
        request.resource.data.createdAt is timestamp;

      allow update, delete: if signedIn() && request.auth.uid == userId;
    }


    // =========================================================
    // DAILY ANALYTICS ROLLUPS
    // =========================================================
    // One document per day (id = YYYY-MM-DD), written only by the Cloudflare
    // Worker's cron job via a service-account token (which bypasses these
    // rules). Clients read them for the Analytics screen; no client writes.

    match /dailyStats/{dateId} {

      allow read, list: if isStaff();

      allow write: if false;
    }


    // =========================================================
    // CHATBOT UNANSWERED QUESTIONS
    // =========================================================

    match /chatbotUnansweredQuestions/{questionId} {

      allow read, list: if isStaff();

      allow create: if signedIn() &&
        request.resource.data.prompt is string &&
        request.resource.data.intent is string &&
        request.resource.data.confidence is number &&
        request.resource.data.createdAt is timestamp;

      // Staff (moderator/teacher/admin) can clear reviewed questions from
      // the list once they've added an AI Memory entry or training example
      // for them. Entries stay immutable otherwise — no edits, only removal.
      allow update: if false;
      allow delete: if isStaff();
    }


    // =========================================================
    // CHATBOT GENERAL-KNOWLEDGE CACHE
    // =========================================================
    // One doc per normalized question (utils/knowledgeCache.ts), storing an
    // answer retrieved live from a public API (Wikipedia, Wiktionary, REST
    // Countries — see utils/generalKnowledgeApi.ts) so the same question
    // next time is answered from Firestore instead of another API call.
    // Any signed-in user's app can write a cache entry (it's retrieved,
    // cited text, not user-authored content), bounded by size/shape so a
    // modified client can't stuff arbitrary large payloads in here. Staff
    // can delete a bad entry to force a re-fetch.

    // =========================================================
    // AUTH CODES (password reset / recovery-email verification)
    // =========================================================
    // 6-digit codes for the email-based password reset flow. Written, read
    // and deleted only by the trusted Cloudflare Worker via the service
    // account (which bypasses these rules). Codes are stored hashed and are
    // never exposed to any client, so all direct client access is denied.

    match /authCodes/{codeId} {
      allow read, write: if false;
    }

    match /chatbotKnowledgeCache/{cacheKey} {

      allow read, list: if signedIn();

      allow create, update: if signedIn() &&
        request.resource.data.answer is string &&
        request.resource.data.answer.size() > 0 &&
        request.resource.data.answer.size() <= 4000 &&
        request.resource.data.question is string &&
        request.resource.data.question.size() <= 500 &&
        request.resource.data.provider in [
          'wikipedia', 'restcountries', 'wiktionary', 'frankfurter', 'open-meteo'
        ];

      allow delete: if isStaff();
    }


    // =========================================================
    // MODERATION FEEDBACK
    // =========================================================

    match /moderationFeedback/{feedbackId} {

      allow read, list: if isStaff();

      allow create: if isStaff() &&
        request.resource.data.contentType is string &&
        request.resource.data.contentId is string &&
        request.resource.data.reportId is string &&
        request.resource.data.moderatorDecision is string &&
        request.resource.data.source == 'user_report' &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt is timestamp;

      allow update: if isStaff();

      allow delete: if isStaff();
    }


    // =========================================================
    // CAMPUS KNOWLEDGE FAQ
    // =========================================================
    // Admin-maintained FAQ answers the non-generative chatbot reads at
    // runtime (campus_knowledge intent). Any signed-in user may read so the
    // assistant can answer; only admins may add, edit, or remove entries.

    match /campusFaq/{faqId} {

      function validCampusFaq(data) {
        return data.question is string &&
          data.question.size() > 0 &&
          data.question.size() <= 300 &&
          data.answer is string &&
          data.answer.size() > 0 &&
          data.answer.size() <= 2000;
      }

      allow read, list: if signedIn();

      allow create: if isAdmin() &&
        validCampusFaq(request.resource.data) &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt is timestamp;

      allow update: if isAdmin() &&
        validCampusFaq(request.resource.data) &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt is timestamp;

      allow delete: if isAdmin();
    }

    // =========================================================
    // YEAR LEVEL PROMOTION
    // =========================================================
    //
    // An admin writes a schedule here; the runYearLevelPromotions Cloud
    // Function (functions/index.js) claims it and does the work. That job runs
    // through the Admin SDK, which bypasses these rules entirely — so nothing
    // below needs to grant the backend anything. Students never read or write
    // either collection; they only see the result on their own profile.

    match /promotionSchedules/{scheduleId} {

      allow read, list: if isAdmin();

      // A schedule may only ever be created in the pending state, so a client
      // cannot skip the queue by writing one that claims to be finished.
      allow create: if isAdmin() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.runAt is timestamp &&
        request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    match /promotionRuns/{runId} {

      allow read, list: if isAdmin();

      // The audit trail is written only by the backend. Leaving it read-only
      // here keeps the record of who was promoted, and from what, intact.
      allow write: if false;

      match /changes/{chunkId} {
        allow read, list: if isAdmin();
        allow write: if false;
      }
    }

    // =========================================================
    // HELP & SUPPORT TICKETS
    // =========================================================
    //
    // A ticket is private between the person who filed it and the
    // administrators. Everyone can file one and read their own; only admins
    // read anyone else's.
    //
    // Administrators only, not staff generally, for two reasons. Moderators
    // are students — they carry @student.csap accounts and a programme — so
    // staff-wide access would let one student read another's account and
    // records problems. And answering these needs someone who knows how the
    // system actually works, which is the administrators.
    //
    // Status, priority and assignment are admin-only because a student who
    // can set their own priority sets it to urgent, and one who can set their
    // own status can close a problem that was never solved.

    function ticketOwner() {
      return resource.data.userId == request.auth.uid;
    }

    // Fields only staff may introduce or change.
    // Triage decisions. An owner may never touch these.
    //
    // unreadForStaff is deliberately NOT here: every reply sets it, so
    // listing it blocked a student from replying to their own request at all
    // — the message was written but the ticket never updated, so it never
    // rose into the administrators' queue and nobody knew they had answered.
    // It is governed by ownerMayFlagStaff() below instead.
    function ticketAdminFields() {
      return ['status', 'priority', 'assignedTo', 'assignedToName'];
    }

    // An owner may raise the "waiting on us" flag by writing, but never lower
    // it — clearing it would hide their own request from the queue.
    function ownerMayFlagStaff() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['unreadForStaff']) ||
             request.resource.data.unreadForStaff == true;
    }

    match /supportTickets/{ticketId} {

      allow get: if signedIn() && (ticketOwner() || isAdmin());

      // Students cannot list the collection — that would expose every other
      // student's problems. Their own list is a query filtered to their uid,
      // which `get` above already authorizes per document; staff list freely.
      allow list: if signedIn() && (
        isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid)
      );

      // A ticket always starts unowned, unprioritized and open, whoever files
      // it, and always belongs to the person filing it.
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.priority == 'normal' &&
        request.resource.data.assignedTo == null &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() > 0 &&
        request.resource.data.subject.size() <= 200 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 4000;

      allow update: if signedIn() && (
        isAdmin() ||
        (
          ticketOwner() &&
          // The owner may only ever mark their own copy read or push the
          // conversation forward — never triage their own ticket.
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(ticketAdminFields()) &&
          ownerMayFlagStaff() &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['userId', 'ticketNo', 'userRole', 'createdAt'])
        )
      );

      // Tickets are a record. Staff close them; nobody deletes them.
      allow delete: if false;

      match /messages/{messageId} {

        function parentTicket() {
          return get(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
        }

        allow read, list: if signedIn() && (
          isAdmin() || parentTicket().userId == request.auth.uid
        );

        // `fromStaff` decides which side of the thread a message renders on
        // and who the unread flag moves to, so a student must not be able to
        // post one claiming to be support.
        allow create: if signedIn() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.body is string &&
          request.resource.data.body.size() <= 4000 &&
          // A screenshot on its own is a valid message, so an empty body is
          // allowed only when there is an image to carry it.
          (
            request.resource.data.body.size() > 0 ||
            request.resource.data.get('imageUrl', null) != null
          ) &&
          (
            (isAdmin() && request.resource.data.fromStaff == true) ||
            (
              parentTicket().userId == request.auth.uid &&
              request.resource.data.fromStaff == false
            )
          );

        allow update, delete: if false;
      }
    }

    // Running ticket number. Students need to increment it to file a ticket,
    // so the rule pins the only legal change: exactly one more than it was.
    // Anything else — a jump, a reset, a rewrite — is refused.
    match /counters/supportTickets {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.value == 1;
      allow update: if signedIn() &&
        request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }
  }
}
