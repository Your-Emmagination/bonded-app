{
  "expo": {
    "name": "BondEd",
    "slug": "bonded-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bondedapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#5f0909",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.encabo.bondedapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "BondEd uses your camera to take photos in messages and host live streams.",
        "NSMicrophoneUsageDescription": "BondEd uses your microphone when you host a live stream."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.encabo.bondedapp",
      "googleServicesFile": "./google-services.json",
      "backgroundColor": "#5f0909",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#e0a53d",
          "sounds": [
            "./assets/sounds/notif_default.wav",
            "./assets/sounds/notif_chime.wav",
            "./assets/sounds/notif_pop.wav",
            "./assets/sounds/notif_bubble.wav",
            "./assets/sounds/notif_alert.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-video",
      "expo-audio",
      "expo-file-system",
      [
        "expo-media-library",
        {
          "photosPermission": "BondEd needs access to your photos to save images you download from chats.",
          "savePhotosPermission": "BondEd saves photos you download from chats to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-asset",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "aiWorkerUrl": "https://bonded-ai-worker.encaboemmz77.workers.dev",
      "agoraAppId": "b2042228efe24464a3b218dc91198d7b",
      "agoraTokenEndpoint": "",
      "router": {},
      "eas": {
        "projectId": "fcf84c1d-4b2b-408b-b8ac-be878865d028"
      }
    }
  }
}
